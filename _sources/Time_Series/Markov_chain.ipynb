   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "a = 0.99\n",
    "x = np.zeros((100,1))\n",
    "for i in range(1,np.size(x)):\n",
    "    x[i] = a*x[i-1]+np.power(1-a**2,0.5)*np.random.normal(0,1)\n",
    "\n",
    "lag = 1\n",
    "plt.figure()\n",
    "plt.plot(x)\n",
    "plt.figure()\n",
    "plt.scatter(x[0:-lag],x[lag:])\n"
   ]
  }
 ],
